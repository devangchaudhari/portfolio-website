# ==============================================================================
# DEVANG CHAUDHARI PORTFOLIO — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://portfolio:portfolio_secret@localhost:5432/portfolio_db

# Email Configuration (Nodemailer / SMTP)
# Leave blank during local testing to run in safe "simulated_local" mode (logs to console)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
EMAIL_FROM=noreply@devangchaudhari.dev
RECIPIENT_EMAIL=devangchaudhari2003@gmail.com

# AI Integration (Optional)
# Used for live LLM candidate profile matching and expense auditing
GEMINI_API_KEY=your_gemini_api_key_here
